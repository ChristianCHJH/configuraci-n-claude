# Credenciales y secretos
.credentials.json

# Config por máquina (rutas específicas de cada PC)
settings.json

# Caché y estado efímero
cache/
paste-cache/
mcp-needs-auth-cache.json
.last-cleanup
.last-update-result.json

# Historial de sesiones (potencialmente sensible y grande)
history.jsonl
sessions/
session-env/
