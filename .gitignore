file-history/

# Telemetría y descargas
telemetry/
downloads/

# IDE state
ide/

# Backups auto-generados
backups/

# Projects: ignorar todo excepto memory/ (historiales tienen tokens/secretos)
projects/**/*.jsonl
projects/**/*.json
projects/**/*.txt
projects/**/*.pdf
